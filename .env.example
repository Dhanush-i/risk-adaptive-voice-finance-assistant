# ============================================================
# Risk-Adaptive Voice Finance Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.

# Razorpay API Keys (required for payments)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# JWT Secret Key (change this to a random string in production!)
JWT_SECRET_KEY=voicepay-change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///storage/voice_finance.db

# App
APP_ENV=development
APP_DEBUG=true
